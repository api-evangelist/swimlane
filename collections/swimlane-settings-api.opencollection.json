{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swimlane REST Applications Settings API",
    "version": "10.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get server settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.swimlane.app/api/settings"
          },
          "docs": "Retrieve server settings and version information"
        }
      ]
    }
  ],
  "bundled": true
}