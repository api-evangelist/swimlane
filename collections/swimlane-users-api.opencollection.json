{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swimlane REST Applications Users API",
    "version": "10.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.swimlane.app/api/user",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of users to return per page"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (zero-based)"
              }
            ]
          },
          "docs": "Retrieve a paginated list of all users"
        },
        {
          "info": {
            "name": "Get user by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.swimlane.app/api/user/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "User identifier"
              }
            ]
          },
          "docs": "Retrieve a single user by their unique identifier"
        },
        {
          "info": {
            "name": "Search users by display name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.swimlane.app/api/user/search",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search term for user display name"
              }
            ]
          },
          "docs": "Search users matching a display name query"
        }
      ]
    }
  ],
  "bundled": true
}